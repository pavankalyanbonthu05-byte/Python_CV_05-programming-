    "    \"class Student:\\n\",\n",
    "    \"    passing_marks = 40\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __init__(self, name, marks):\\n\",\n",
    "    \"        self.name = name\\n\",\n",
    "    \"        self.marks = marks\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def result(self):\\n\",\n",
    "    \"        status = \\\"Pass\\\" if self.marks >= Student.passing_marks else \\\"Fail\\\"\\n\",\n",
    "    \"        print(f\\\"{self.name}: {status}\\\")\\n\",\n",
    "    \"\\n\",\n",
