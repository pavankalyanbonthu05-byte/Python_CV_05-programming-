    "    \"\\n\",\n",
    "    \"class Student:\\n\",\n",
    "    \"    def __init__(self, name, marks):\\n\",\n",
    "    \"        self.name = name\\n\",\n",
    "    \"        self.marks = marks\\n\",\n",
    "    \"    def is_passed(self):\\n\",\n",
    "    \"        return self.marks > 40\\n\",\n",
    "    \"s1=Student('Sagar', 60)\\n\",\n",
    "    \"s2=Student('max', 30)\\n\",\n",
    "    \"students=[s1,s2]\\n\",\n",
    "    \"for i in students:\\n\",\n",
    "    \"    status = 'Passed' if i.is_passed() else 'Failed'\\n\",\n",
    "    \"    print(f'{i.name} has {status}')\\n\",\n",
    "    \"\\n\"\n",
    "   ],\n",
