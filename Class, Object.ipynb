    "    \"        return sal > 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"e1 = Employee(\\\"A\\\", 1000)\\n\",\n",
    "    \"e2 = Employee(\\\"B\\\", 2000)\\n\",\n",
    "    \"print(f\\\"Salaries: {e1.final_salary()}, {e2.final_salary()}\\\")\\n\",\n",
    "    \"Employee.update_bonus(0.2)\\n\",\n",
