    "    \"class students:\\n\",\n",
    "    \"    def __init__(self,name,marks):\\n\",\n",
    "    \"        self.name = name\\n\",\n",
    "    \"        self.marks = marks\\n\",\n",
    "    \"    def is_passed(self):\\n\",\n",
    "    \"        if self.marks > 40:\\n\",\n",
    "    \"            return True\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            return False\\n\",\n",
    "    \"s1=students('Bob', 48)\\n\",\n",
    "    \"s2=students('ram', 94)\\n\",\n",
    "    \"for s in [s1,s2]:\\n\",\n",
    "    \"    status = 'passed' if s.is_passed() else 'Failed'\\n\",\n",
    "    \"    print(f\\\"{s.name} has {status}.\\\")\"\n",
    "   ],\n",
