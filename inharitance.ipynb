    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \" '''Create a base class Animal with a method sound(). Create a derived class Dog\\n\",\n",
    "    \"that overrides the sound() method. Demonstrate method overriding.'''\\n\",\n",
    "    \"class animal:\\n\",\n",
    "    \"    def sound(self):\\n\",\n",
    "    \"        print('some generic animal sound')\\n\",\n",
    "    \"class dog(animal):\\n\",\n",
    "    \"    def sound(self):\\n\",\n",
    "    \"        print('Bark!')\\n\",\n",
    "    \"a = animal()\\n\",\n",
    "    \"a.sound()\\n\",\n",
    "    \"d=dog()\\n\",\n",
    "    \"d.sound()\\n\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"some generic animal sound\\n\",\n",
    "      \"Bark!\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 2\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-18T07:09:55.098306300Z\",\n",
    "     \"start_time\": \"2026-02-18T07:09:55.049537600Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \" '''Create class A with method show(). Create class B(A) that overrides show() and\\n\",\n",
    "    \"also calls the parent method using super().'''\\n\",\n",
    "    \"class A:\\n\",\n",
    "    \"    def show(self):\\n\",\n",
    "    \"        print('Show sprit')\\n\",\n",
    "    \"class B(A):\\n\",\n",
    "    \"    def show(self):\\n\",\n",
    "    \"        print('show RRR')\\n\",\n",
    "    \"        super().show()\\n\",\n",
    "    \"obj = B()\\n\",\n",
    "    \"obj.show()\"\n",
    "   ],\n",
    "   \"id\": \"3ae126f8775de04e\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"show RRR\\n\",\n",
    "      \"Show sprit\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 5\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-19T06:38:35.466400100Z\",\n",
    "     \"start_time\": \"2026-02-19T06:38:35.441669600Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"'''Create multi-level inheritance with classes A → B → C, each having a method\\n\",\n",
    "    \"display() printing the class name. Create object of C and call display(),\\n\",\n",
    "    \"showing method resolution'''\\n\",\n",
    "    \"\\n\",\n",
    "    \"class A:\\n\",\n",
    "    \"    def display(self):\\n\",\n",
    "    \"        print('class A')\\n\",\n",
    "    \"class B(A):\\n\",\n",
    "    \"    def display(self):\\n\",\n",
    "    \"        super().display()\\n\",\n",
    "    \"        print('class B')\\n\",\n",
    "    \"class C(B):\\n\",\n",
    "    \"    def display(self):\\n\",\n",
    "    \"        super().display()\\n\",\n",
    "    \"        print('class C')\\n\",\n",
    "    \"d = C()\\n\",\n",
    "    \"d.display()\"\n",
    "   ],\n",
    "   \"id\": \"f0b167b5ac08c61b\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"class A\\n\",\n",
    "      \"class B\\n\",\n",
    "      \"class C\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 13\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-19T06:48:21.037630700Z\",\n",
    "     \"start_time\": \"2026-02-19T06:48:21.017679900Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"'''Implement hierarchical inheritance using a base class Vehicle and two child\\n\",\n",
    "    \"classes Car and Bike, each defining a method wheels()'''\\n\",\n",
    "    \"\\n\",\n",
    "    \"class vehicle():\\n\",\n",
    "    \"    def wheels(self):\\n\",\n",
    "    \"        print('vehicle has 4 wheels')\\n\",\n",
    "    \"class car(vehicle):\\n\",\n",
    "    \"    def wheels(self):\\n\",\n",
    "    \"        super().wheels()\\n\",\n",
    "    \"        print('car has 4 wheels')\\n\",\n",
    "    \"class bike(vehicle):\\n\",\n",
    "    \"    def wheels(self):\\n\",\n",
    "    \"        super().wheels()\\n\",\n",
    "    \"        print('bike has 2 wheels')\\n\",\n",
    "    \"d=bike()\\n\",\n",
    "    \"d.wheels()\\n\",\n",
    "    \"e=car()\\n\",\n",
    "    \"e.wheels()\"\n",
    "   ],\n",
    "   \"id\": \"4b56f8469671b3db\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"vehicle has 4 wheels\\n\",\n",
    "      \"bike has 2 wheels\\n\",\n",
    "      \"vehicle has 4 wheels\\n\",\n",
    "      \"car has 4 wheels\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 20\n",
